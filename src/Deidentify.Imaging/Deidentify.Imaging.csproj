<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Deidentify.Imaging</PackageId>
    <Description>Optional imaging adapters for Deidentify.NET.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/d-german/deidentify-dotnet</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Deidentify\Deidentify.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Docnet.Core" />
    <PackageReference Include="fo-dicom" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Tesseract.Data.English" GeneratePathProperty="true" />
    <PackageReference Include="TesseractOCR" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)tesseract.data.english\4.0.0\build\tessdata\eng.traineddata"
          Pack="true"
          PackagePath="contentFiles\any\any\tessdata\" />
    <None Include="$(NuGetPackageRoot)tesseractocr\5.5.2\x64\*.dll"
          Pack="true"
          PackagePath="native\win-x64\" />
    <None Include="$(NuGetPackageRoot)tesseractocr\5.5.2\x86\*.dll"
          Pack="true"
          PackagePath="native\win-x86\" />
    <None Include="build\Deidentify.Imaging.targets"
          Pack="true"
          PackagePath="build\Deidentify.Imaging.targets" />
    <None Include="build\Deidentify.Imaging.targets"
          Pack="true"
          PackagePath="buildTransitive\Deidentify.Imaging.targets" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
